---
import '../styles/global.css';
const { title, description } = Astro.props;
const pageTitle = title ? `${title}｜昭和の戦争を読む` : '昭和の戦争を読む — 39冊で俯瞰する書籍ナビ';
const desc = description ?? '満州事変から敗戦までを、著者の方法論×出来事×視点で俯瞰する戦争書籍ナビ。';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700&family=Noto+Serif+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23f4efe4'/><rect x='6' y='5' width='6' height='22' fill='%23211d16'/><rect x='14' y='5' width='6' height='22' fill='%23a83c25'/><rect x='22' y='8' width='5' height='19' fill='%234a5568'/></svg>" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <div>
          <div class="site-title"><a href="/">昭和の戦争<span class="tsubo">を</span>読む</a></div>
          <div class="site-tag">満州事変から敗戦まで——39冊で俯瞰する書籍ナビ</div>
        </div>
        <nav class="site-nav">
          <a href="/#matrix">俯瞰マトリクス</a>
          <a href="/#authors">著者から</a>
          <a href="/#pairs">対で読む</a>
          <a href="/about/">このサイトについて</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <p>昭和の戦争を読む — 書誌情報は各出版社の公式ページ・国立国会図書館サーチで確認のうえ掲載しています（2026年8月時点）。</p>
        <p>Amazonのアソシエイトとして、昭和の戦争を読むは適格販売により収入を得ています。</p>
        <p>本の紹介文は当サイトの編集によるものです。著者の優劣や史観の当否を判定するものではありません。</p>
        <p>© 昭和の戦争を読む</p>
      </div>
    </footer>

    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }
        }, { threshold: 0.08 });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
